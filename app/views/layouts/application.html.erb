<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<script>try{var t=localStorage.getItem("didlint-theme");if(t==="light"||t==="dark")document.documentElement.setAttribute("data-theme",t)}catch(e){}</script>
<link rel="icon" href="/oyd-mark.svg" type="image/svg+xml">
<title><%= full_title(yield(:title)) %></title>
<meta name="description" content="DID Linter checks DID documents against the W3C Decentralized Identifiers (DIDs) v1.0 specification, with rules described as a SOyA structure. Operated by OwnYourData.">
<%= csrf_meta_tags %>
<style>
  :root {
    color-scheme: light;
    --bg: #f7f7f5;
    --surface: #ffffff;
    --text: #1d2327;
    --muted: #5b6770;
    --line: #e2e5e8;
    --accent: #0b6e4f;
    --accent-soft: #e3f2ec;
    --wip: #8a5a00;
    --wip-soft: #fbf0d9;
    --bad: #b42318;
    --bad-soft: #fdecea;
    --radius: 12px;
  }
  /* dark: follows the system unless the visitor picked a theme (data-theme on <html>) */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      color-scheme: dark;
      --bg: #121517;
      --surface: #1b1f22;
      --text: #e8ebed;
      --muted: #9aa5ad;
      --line: #2c3236;
      --accent: #4cc293;
      --accent-soft: #173229;
      --wip: #e6b85c;
      --wip-soft: #33291a;
      --bad: #f28b82;
      --bad-soft: #3a1f1d;
    }
  }
  :root[data-theme="dark"] {
    color-scheme: dark;
    --bg: #121517;
    --surface: #1b1f22;
    --text: #e8ebed;
    --muted: #9aa5ad;
    --line: #2c3236;
    --accent: #4cc293;
    --accent-soft: #173229;
    --wip: #e6b85c;
    --wip-soft: #33291a;
    --bad: #f28b82;
    --bad-soft: #3a1f1d;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 16px/1.55 system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  }
  a { color: var(--accent); }
  .wrap { max-width: 960px; margin: 0 auto; padding: 0 20px; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  header { padding: 20px 0; border-bottom: 1px solid var(--line); }
  header .wrap { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
  .brand { display: inline-flex; align-items: center; gap: 9px; font-weight: 600; letter-spacing: .01em; white-space: nowrap; color: var(--text); text-decoration: none; }
  .brand .mark { width: 15px; height: auto; display: block; }
  .brand span { color: var(--muted); font-weight: 400; margin-left: -5px; }
  header nav { display: flex; align-items: center; }
  header nav a { color: var(--muted); text-decoration: none; margin-left: 18px; font-size: 15px; }
  header nav a:hover { color: var(--text); }
  .theme-toggle {
    background: none; border: 1px solid var(--line); border-radius: 8px; color: var(--muted);
    width: 34px; height: 34px; padding: 0; margin-left: 18px; cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center;
  }
  .theme-toggle[hidden] { display: none; }
  .theme-toggle:hover { color: var(--text); border-color: var(--muted); }
  .theme-toggle svg { width: 18px; height: 18px; }
  .theme-toggle .icon-sun { display: none; }
  .theme-toggle[data-mode="dark"] .icon-sun { display: block; }
  .theme-toggle[data-mode="dark"] .icon-moon { display: none; }
  .intro { padding: 24px 0 18px; }
  .lead { font-size: 17px; color: var(--muted); max-width: 760px; margin: 0; }
  h2 { font-size: 20px; margin: 44px 0 16px; }
  .stack { display: grid; gap: 16px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 16px; }
  .card, .panel {
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 20px;
  }
  .card { display: flex; flex-direction: column; gap: 10px; }
  .card h3 { margin: 0; font-size: 17px; }
  .card p { margin: 0; color: var(--muted); font-size: 15px; flex: 1; }
  .card .links { font-size: 15px; display: flex; gap: 14px; flex-wrap: wrap; }
  .panel p { margin: 0 0 8px; color: var(--muted); }
  .panel p:last-child { margin-bottom: 0; }
  .panel p.note { margin: 20px 2px 0; }
  .btn {
    display: inline-block; padding: 10px 18px; border-radius: 8px; text-decoration: none; cursor: pointer;
    font: inherit; font-weight: 600; font-size: 15px; border: 1px solid var(--accent);
  }
  .btn.primary { background: var(--accent); color: var(--surface); }
  .btn.secondary { color: var(--accent); background: transparent; }
  .check { display: flex; flex-direction: column; gap: 12px; }
  .check label { font-weight: 600; font-size: 15px; }
  .check .hint { color: var(--muted); font-size: 14px; margin: 0; }
  .row { display: flex; gap: 10px; flex-wrap: wrap; }
  .row input { flex: 1 1 320px; }
  input[type=text], textarea {
    width: 100%; font: inherit; color: var(--text); background: var(--bg);
    border: 1px solid var(--line); border-radius: 8px; padding: 10px 12px;
  }
  textarea { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 14px; min-height: 240px; resize: vertical; }
  input[type=text]:focus, textarea:focus, .btn:focus-visible, .theme-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  .results { scroll-margin-top: 72px; }
  .result { border-radius: var(--radius); padding: 14px 18px; margin: 4px 0 0; border: 1px solid var(--line); border-left-width: 4px; background: var(--surface); }
  .result + .result { margin-top: 10px; }
  .result.success { border-left-color: var(--accent); background: var(--accent-soft); color: var(--accent); font-weight: 600; }
  .result.danger { border-left-color: var(--bad); background: var(--bad-soft); }
  .result.warning { border-left-color: var(--wip); background: var(--wip-soft); }
  .result.info { border-left-color: var(--muted); }
  .result ul { margin: 6px 0 0; padding-left: 20px; }
  ol.steps { margin: 0; padding-left: 22px; }
  ol.steps li { margin: 0 0 10px; color: var(--muted); }
  ol.steps li:last-child { margin-bottom: 0; }
  ol.steps strong { color: var(--text); }
  ul.repos { list-style: none; margin: 0; padding: 0; }
  ul.repos li { display: flex; justify-content: space-between; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--line); flex-wrap: wrap; }
  ul.repos li:last-child { border-bottom: 0; }
  ul.repos .what { color: var(--muted); font-size: 15px; }
  pre { margin: 8px 0 0; padding: 10px 12px; background: var(--bg); border: 1px solid var(--line); border-radius: 8px; font-size: 13px; white-space: pre-wrap; word-break: break-all; }
  code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: .92em; overflow-wrap: anywhere; }
  .note { color: var(--muted); font-size: 13px; max-width: 760px; }
  footer { margin-top: 56px; padding: 24px 0 40px; border-top: 1px solid var(--line); color: var(--muted); font-size: 14px; }
  footer .wrap { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  footer a { color: var(--muted); }
  footer .legal a { margin-right: 16px; }
  footer .legal a:last-child { margin-right: 0; }
  footer .funding { flex-basis: 100%; font-size: 13px; }
  @media (max-width: 560px) {
    header nav a { margin: 0 14px 0 0; }
    .theme-toggle { margin-left: 0; }
    .intro { padding-top: 18px; }
  }
</style>
</head>
<body>

<header>
  <div class="wrap">
    <a class="brand" href="/"><img class="mark" src="/oyd-mark.svg" alt="" width="15" height="28">DID Linter <span>· OwnYourData</span></a>
    <nav>
      <a href="/api-docs/index.html">API</a>
      <a href="https://github.com/OwnYourData/didlint">GitHub</a>
      <button type="button" class="theme-toggle" id="theme-toggle" hidden>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
    </nav>
  </div>
</header>

<main class="wrap">
<%= yield %>
</main>

<footer>
  <div class="wrap">
    <div>Operated by <a href="https://www.ownyourdata.eu/en/">OwnYourData</a></div>
    <div class="legal">
      <a href="https://www.ownyourdata.eu/en/imprint/">Imprint</a>
      <a href="https://www.ownyourdata.eu/en/privacy-policy/">Privacy</a>
      <a href="/version">Version</a>
    </div>
    <div class="funding">This project has received funding from the European Union’s Horizon 2020 research and innovation program through the <a href="https://ontochain.ngi.eu/">NGI ONTOCHAIN</a> program under cascade funding agreement No 957338 and the <a href="https://trustchain.ngi.eu/">NGI TRUSTCHAIN</a> program under cascade funding agreement No 101093274.</div>
  </div>
</footer>

<script>
(function () {
  var b = document.getElementById("theme-toggle"), r = document.documentElement;
  var m = window.matchMedia("(prefers-color-scheme: dark)");
  function system() { return m.matches ? "dark" : "light"; }
  function current() { return r.getAttribute("data-theme") || system(); }
  function show() {
    var dark = current() === "dark";
    b.setAttribute("data-mode", dark ? "dark" : "light");
    b.setAttribute("aria-label", dark ? "Switch to light mode" : "Switch to dark mode");
    b.title = b.getAttribute("aria-label");
  }
  b.addEventListener("click", function () {
    var next = current() === "dark" ? "light" : "dark";
    try {
      if (next === system()) { r.removeAttribute("data-theme"); localStorage.removeItem("didlint-theme"); }
      else { r.setAttribute("data-theme", next); localStorage.setItem("didlint-theme", next); }
    } catch (e) { r.setAttribute("data-theme", next); }
    show();
  });
  if (m.addEventListener) m.addEventListener("change", show);
  b.hidden = false;
  show();
})();
</script>

</body>
</html>
