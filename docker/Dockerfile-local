FROM oydeu/soya-cli:alpha@sha256:3ce0a93c97e6d707de33a960ebbee9ab5c7c1c120c5df58cebf9099785ea46c6
LABEL org.opencontainers.image.authors="Christoph Fabianek <christoph@ownyourdata.eu>"

USER root
RUN mkdir -p /usr/src/app && \
	apk add --no-cache libsodium-dev build-base git make gcc musl-dev jq npm openjdk8 bash curl libpq-dev sqlite-dev yaml-dev
WORKDIR /usr/src/app
ENV RAILS_ROOT=/usr/src/app/
ENV BUNDLE_FROZEN=true

COPY Gemfile Gemfile.lock $RAILS_ROOT
COPY docker/local-gem/*.gem /tmp/
RUN gem install bundler -v 2.6.9 && \
	gem install /tmp/*.gem && \
	bundle install

COPY . .

CMD ["./docker/init.sh"]

EXPOSE 3000
